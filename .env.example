# Not required — DB settings are in application-<profile>.yml
# Optional overrides only (Spring env vars still win if set)

# Required to enable transactional email (welcome/reset/order emails)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Required to enable the N-Genius payment gateway integration
NGENIUS_OUTLET_REF=b2e1c46c-efbd-47eb-ad53-c72f92d09bf1
NGENIUS_API_KEY=
NGENIUS_REDIRECT_URL=
NGENIUS_CANCEL_URL=
NGENIUS_WEBHOOK_HEADER_NAME=X-Webhook-Secret
NGENIUS_WEBHOOK_HEADER_VALUE=
