# Not required — DB settings are in application-<profile>.yml
# Optional overrides only (Spring env vars still win if set)

# Optional: create the first super admin when no admins exist yet
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=Super Admin

# Required to enable transactional email (welcome/reset/order emails)
# For local/docker: copy to .env and fill in values (see application-staging.yml for staging defaults)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Required to enable the N-Genius payment gateway integration
NGENIUS_OUTLET_REF=b2e1c46c-efbd-47eb-ad53-c72f92d09bf1
NGENIUS_API_KEY=
NGENIUS_REDIRECT_URL=
NGENIUS_CANCEL_URL=
NGENIUS_WEBHOOK_HEADER_NAME=X-Webhook-Secret
NGENIUS_WEBHOOK_HEADER_VALUE=
